{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "components/accessories/SectorFileringComponents/FetchColumns.tsx",
    "components/Billing/UpdatingOutstandingDebt/UpdatOutstandingDebt.tsx",
    "components/Billing/TransactionDetailsModal.jsx",
    "app/operations/laboratory/sample/rejected/history/page.jsx",
    "components/LabTestForms/testrule.jsx",
    "components/phelobotomy/Analytics/TemplatesComponentAnalytics/TestAscensionOverMontOverYear.jsx",
    "v2/primelabsystem/app/customers/index.js",
    "components/registration/fields/Util.ts",
    "app/billing/expenses/category/page.tsx",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "master-admin-app",
    "v2"
  ]
}