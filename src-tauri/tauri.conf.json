{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "prime lab system(pls)",
  "version": "0.1.0",
  "identifier": "primelabsys.com",
  "build": {
    "devUrl": "https://localhost:3000",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Prime Laboratory System Enterprise Version",
        "width": 800,
        "height": 600,
        "resizable": true,
        "url": "https://localhost:3000",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}