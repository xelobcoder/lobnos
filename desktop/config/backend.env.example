# This file is copied to the user's application-data directory on first launch.
# Set real production database and service values in desktop/config/backend.env
# before packaging. That file is ignored by Git.
NODE_ENV=production
PRODUCTION_PORT=2300
PRODUCTION_DB_HOSTNAME=127.0.0.1
PRODUCTION_DB_PORT=3306
PRODUCTION_DATABASE=prime_laboratory_system
PRODUCTION_DB_USERNAME=CHANGE_ME
PRODUCTION_DB_PASSWORD=CHANGE_ME
