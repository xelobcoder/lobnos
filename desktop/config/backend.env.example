# This file is copied to the user's application-data directory on first launch.
# Set real production database and service values in desktop/config/backend.env
# before packaging. That file is ignored by Git.
NODE_ENV=production
PRODUCTION_PORT=2300
PRODUCTION_DB_HOSTNAME=127.0.0.1
PRODUCTION_DB_PORT=3306
PRODUCTION_DATABASE=prime_laboratory_system
PRODUCTION_DB_USERNAME=CHANGE_ME
PRODUCTION_DB_PASSWORD=CHANGE_ME

# See the backend signed-licensing guide for enforcement and public-key setup.
# Numeric registered facility ID used by License menu export/import commands.
# PLS_LICENSE_TENANT_ID=990556
# Existing deployments remain legacy until signed enforcement is configured.
# PLS_LICENSE_MODE=signed
# PLS_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...issuer public key...\n-----END PUBLIC KEY-----"
# NEVER put the issuer private key in a customer environment or installer.
# Desktop always stores installation state in user application-data/licensing.
