{
  "name": "PLS",
  "productName": "Prime Laboratory Software",
  "version": "1.0.0",
  "description": "Prime Laboratory Software desktop and server-rendered web application",
  "author": "Prime Laboratory Software",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next  dev -p 2377",
    "next": "node ./node_modules/next/dist/bin/next  dev -p 2377",
    "start": "node ./node_modules/next/dist/bin/next  start -p 2377 ",
    "build": "next build",
    "ns": "node --env-file=.env server.js -p 2377",
    "service:prereq:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/install-nssm.ps1",
    "service:install:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/install-service.ps1 -StartNow",
    "service:uninstall:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/uninstall-service.ps1",
    "service:start:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action start",
    "service:stop:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action stop",
    "service:restart:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action restart",
    "service:status:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action status",
    "tauri": "tauri",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-tauri.ps1 -Action dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-tauri.ps1",
    "desktop:prepare": "node ./desktop/scripts/prepare-runtime.cjs",
    "desktop:run": "node ./desktop/scripts/prepare-runtime.cjs --skip-build && electron ./desktop/main.cjs",
    "desktop:dist": "node ./desktop/scripts/prepare-runtime.cjs --require-config && electron-builder",
    "desktop:dist:win": "node ./desktop/scripts/prepare-runtime.cjs --require-config && electron-builder --win nsis",
    "desktop:dist:win:signed": "node ./desktop/scripts/prepare-runtime.cjs --require-config && electron-builder --win nsis --config.forceCodeSigning=true",
    "desktop:dist:linux": "node ./desktop/scripts/prepare-runtime.cjs --require-config && electron-builder --linux AppImage",
    "desktop:verify": "node ./desktop/scripts/verify-runtime.cjs",
    "clean": "node ./scripts/clean.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "lint:security": "eslint lib/serverRequestContext.ts lib/serverBackendRequest.ts lib/serverBackendProxy.ts lib/sessionCookies.ts components/serverActions/requestHeaders.tsx components/serverActions/backendRequest.ts app/api/auth",
    "typecheck": "tsc --noEmit",
    "typecheck:security": "tsc --project tsconfig.security.json"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^40.2.0",
    "@ckeditor/ckeditor5-react": "^6.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@remixicon/react": "^4.6.0",
    "@tanstack/react-table": "^9.0.0",
    "@zxing/library": "^0.21.3",
    "baseline-browser-mapping": "^2.10.33",
    "bootstrap": "^5.3.3",
    "caniuse-lite": "^1.0.30001793",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.0.3",
    "dropzone": "^6.0.0-beta.2",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "jose": "^6.0.11",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.21.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "motion": "^12.4.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-barcode": "^1.6.1",
    "react-big-calendar": "^1.20.0",
    "react-bootstrap": "^2.10.9",
    "react-datepicker": "^6.9.0",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^4.2.1",
    "react-responsive": "^10.0.0",
    "react-select": "^5.8.0",
    "react-table": "^7.8.0",
    "react-toastify": "11.0.5",
    "react-window": "^2.2.3",
    "recharts": "^2.9.2",
    "tauri": "^0.15.0",
    "viewerjs": "^1.11.7",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.6.3"
  },
  "overrides": {
    "@types/react": "19.3.0"
  }
}
